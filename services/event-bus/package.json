{
  "name": "@apex-ews/event-bus",
  "version": "0.1.0",
  "private": true,
  "description": "APEX EWS event-bus library — pluggable Producer/Consumer over local NDJSON, Kafka (kafkajs/MSK/Redpanda), or in-memory. Used by alerts, cases, indicators, and the BFF to publish to apex.* topics.",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "kafkajs": "^2.2.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.5.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/__tests__/**/*.test.ts"]
  }
}
