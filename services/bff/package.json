{
  "name": "@apex-ews/bff",
  "version": "0.1.0",
  "private": true,
  "description": "Backend-for-frontend. Maps canonical apex.regulatory.events.v2 alert envelopes to the UI's /api/alerts list-row shape (lowercase severity, customer + rule joined names, computed age_min). T3.10.",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "jose": "^5.10.0",
    "pdfkit": "^0.18.0",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.10",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  }
}
