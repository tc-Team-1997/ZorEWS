{
  "description": "Per-tenant spend + activity + cost-per-alert. Driven by FinOps T5.5 endpoint + Prometheus counters.",
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "title": "Active tenants",
      "type": "stat",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "id": 1,
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "count(count by (tenant_id) (apex_ews_audit_chain_verification_status))", "refId": "A"}
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "title": "Monthly cost envelope (USD)",
      "type": "gauge",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "id": 2,
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "sum(apex_ews_finops_monthly_cost_usd)", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "min": 0,
          "max": 30000,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "green"},
              {"value": 25000, "color": "yellow"},
              {"value": 30000, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "title": "Cost per alert (USD)",
      "type": "stat",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "id": 3,
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "apex_ews_finops_cost_per_alert_usd",
          "legendFormat": "{{tenant_id}}",
          "refId": "A"
        }
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}}
    },
    {
      "title": "Cost per customer (USD)",
      "type": "stat",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "id": 4,
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "apex_ews_finops_cost_per_customer_usd",
          "legendFormat": "{{tenant_id}}",
          "refId": "A"
        }
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}}
    },
    {
      "title": "AWS spend by service (last 30d)",
      "type": "barchart",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "id": 5,
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "sum by (service) (apex_ews_finops_service_cost_usd)",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}}
    },
    {
      "title": "Spend per tenant (last 30d)",
      "type": "piechart",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "id": 6,
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "sum by (tenant_id) (apex_ews_finops_monthly_cost_usd)",
          "legendFormat": "{{tenant_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}}
    },
    {
      "title": "Alerts created per tenant per day",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 6},
      "id": 7,
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "sum by (tenant_id) (rate(apex_ews_alerts_created_total[1d]))",
          "legendFormat": "{{tenant_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Cases opened per tenant per day",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 6},
      "id": 8,
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "sum by (tenant_id) (rate(apex_ews_cases_created_total[1d]))",
          "legendFormat": "{{tenant_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Adoption score per tenant (X.4)",
      "type": "bargauge",
      "gridPos": {"x": 0, "y": 18, "w": 12, "h": 6},
      "id": 9,
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "apex_ews_adoption_score",
          "legendFormat": "{{tenant_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "red"},
              {"value": 40, "color": "orange"},
              {"value": 60, "color": "yellow"},
              {"value": 80, "color": "green"}
            ]
          }
        }
      }
    },
    {
      "title": "Audit events per tenant (24h)",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 18, "w": 12, "h": 6},
      "id": 10,
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "sum by (tenant_id) (rate(apex_ews_audit_events_total[24h]))",
          "legendFormat": "{{tenant_id}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5m",
  "schemaVersion": 39,
  "tags": ["finops", "tenant", "adoption", "apex-ews"],
  "templating": {
    "list": [
      {"name": "DS_PROMETHEUS", "type": "datasource", "query": "prometheus", "label": "Prometheus"}
    ]
  },
  "time": {"from": "now-30d", "to": "now"},
  "title": "APEX EWS — tenant spend + adoption",
  "uid": "apex-ews-tenant-spend",
  "version": 1
}
