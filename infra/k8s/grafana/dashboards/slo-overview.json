{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "datasource", "uid": "grafana"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "ZorEWS tier-1 SLO error budgets + burn rates at 1h/6h/3d windows.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "BAU runbook",
      "url": "https://github.com/tc-Team-1997/ZorEWS/blob/main/docs/bau-runbook.md",
      "type": "link",
      "icon": "doc"
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "title": "BFF error budget remaining (30d)",
      "type": "gauge",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 6},
      "id": 1,
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "apex_ews:slo:bff:error_budget_remaining * 100",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "values": false},
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "red"},
              {"value": 25, "color": "orange"},
              {"value": 50, "color": "yellow"},
              {"value": 75, "color": "green"}
            ]
          },
          "min": 0,
          "max": 100,
          "unit": "percent"
        }
      }
    },
    {
      "title": "Audit chain integrity per tenant",
      "type": "stat",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 6},
      "id": 2,
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "apex_ews:audit:chain_valid",
          "legendFormat": "{{tenant_id}}",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "red"},
              {"value": 1, "color": "green"}
            ]
          },
          "mappings": [
            {"type": "value", "options": {"0": {"text": "TAMPERED"}, "1": {"text": "OK"}}}
          ]
        }
      }
    },
    {
      "title": "BFF burn rate — 1h fast",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 6},
      "id": 3,
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "apex_ews:slo:bff:burn_rate:1h", "legendFormat": "1h", "refId": "A"},
        {"expr": "apex_ews:slo:bff:burn_rate:6h", "legendFormat": "6h", "refId": "B"},
        {"expr": "apex_ews:slo:bff:burn_rate:3d", "legendFormat": "3d", "refId": "C"}
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "green"},
              {"value": 1, "color": "yellow"},
              {"value": 6, "color": "orange"},
              {"value": 14.4, "color": "red"}
            ]
          },
          "color": {"mode": "thresholds"},
          "unit": "none"
        }
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "title": "Public API latency p95 (ms)",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 6, "w": 12, "h": 8},
      "id": 4,
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "apex_ews:sli:bff:latency_p95:5m * 1000",
          "legendFormat": "p95 — {{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {"drawStyle": "line", "lineWidth": 1},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "green"},
              {"value": 800, "color": "yellow"},
              {"value": 1500, "color": "red"}
            ]
          },
          "unit": "ms"
        }
      }
    },
    {
      "title": "Alert ingest latency p95",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 6, "w": 12, "h": 8},
      "id": 5,
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "apex_ews:sli:alert:end_to_end_p95:5m",
          "legendFormat": "indicator→alert p95 (s)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {"drawStyle": "line", "lineWidth": 2},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "green"},
              {"value": 30, "color": "yellow"},
              {"value": 60, "color": "red"}
            ]
          },
          "unit": "s"
        }
      }
    },
    {
      "title": "Webhook delivery success rate",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 14, "w": 12, "h": 6},
      "id": 6,
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "apex_ews:sli:webhook:success_rate:5m * 100",
          "legendFormat": "{{subscription_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "red"},
              {"value": 95, "color": "yellow"},
              {"value": 99, "color": "green"}
            ]
          }
        }
      }
    },
    {
      "title": "Aurora writer CPU",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 14, "w": 12, "h": 6},
      "id": 7,
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "apex_ews:sli:aurora:writer_cpu_avg:5m",
          "legendFormat": "writer CPU %",
          "refId": "A"
        },
        {
          "expr": "apex_ews:sli:aurora:reader_cpu_avg:5m",
          "legendFormat": "reader CPU %",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "green"},
              {"value": 65, "color": "yellow"},
              {"value": 80, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "title": "MSK broker disk used %",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 6},
      "id": 8,
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "apex_ews:sli:msk:broker_disk_used_pct",
          "legendFormat": "broker disk %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "green"},
              {"value": 70, "color": "yellow"},
              {"value": 85, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "title": "Aurora Global replica lag (s)",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 6},
      "id": 9,
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "apex_ews:sli:aurora:replica_lag_seconds",
          "legendFormat": "replica lag",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "green"},
              {"value": 60, "color": "yellow"},
              {"value": 120, "color": "red"}
            ]
          }
        }
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["slo", "production", "apex-ews"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus"
      }
    ]
  },
  "time": {"from": "now-3h", "to": "now"},
  "timepicker": {},
  "timezone": "",
  "title": "APEX EWS — SLO overview",
  "uid": "apex-ews-slo-overview",
  "version": 1,
  "weekStart": ""
}
