{
  "description": "Infrastructure layer health — Aurora cluster, MSK brokers, EKS nodes, HPA scaling events.",
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "title": "Aurora writer CPU",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 6},
      "id": 1,
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "apex_ews:sli:aurora:writer_cpu_avg:5m", "legendFormat": "writer", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "green"},
              {"value": 65, "color": "yellow"},
              {"value": 80, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "title": "Aurora reader CPU (autoscaling target: 65%)",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 6},
      "id": 2,
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "apex_ews:sli:aurora:reader_cpu_avg:5m", "legendFormat": "reader avg", "refId": "A"},
        {"expr": "max(aws_rds_cpuutilization_average{role=\"reader\"})", "legendFormat": "reader max", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "percent"}}
    },
    {
      "title": "Aurora DB connections (RDS Proxy backed)",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 6, "w": 12, "h": 6},
      "id": 3,
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "aws_rds_database_connections_average{role=\"writer\"}", "legendFormat": "writer", "refId": "A"},
        {"expr": "aws_rds_database_connections_average{role=\"reader\"}", "legendFormat": "reader", "refId": "B"}
      ]
    },
    {
      "title": "Aurora Global replica lag",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 6, "w": 12, "h": 6},
      "id": 4,
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "apex_ews:sli:aurora:replica_lag_seconds", "legendFormat": "replica lag", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "green"},
              {"value": 60, "color": "yellow"},
              {"value": 120, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "title": "MSK broker disk used %",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 6},
      "id": 5,
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "apex_ews:sli:msk:broker_disk_used_pct", "legendFormat": "broker disk %", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "green"},
              {"value": 70, "color": "yellow"},
              {"value": 85, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "title": "MSK consumer lag (s)",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 6},
      "id": 6,
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "apex_ews:sli:msk:consumer_lag_seconds",
          "legendFormat": "{{consumer_group}}/{{topic}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "title": "EKS nodes by NodePool (Karpenter)",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 18, "w": 12, "h": 6},
      "id": 7,
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "sum by (nodepool) (karpenter_nodes_allocatable_cpu_cores)",
          "legendFormat": "{{nodepool}} CPU cores",
          "refId": "A"
        }
      ]
    },
    {
      "title": "HPA status — current vs desired replicas",
      "type": "table",
      "gridPos": {"x": 12, "y": 18, "w": 12, "h": 6},
      "id": 8,
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "kube_horizontalpodautoscaler_status_current_replicas",
          "legendFormat": "current",
          "refId": "A",
          "format": "table"
        },
        {
          "expr": "kube_horizontalpodautoscaler_status_desired_replicas",
          "legendFormat": "desired",
          "refId": "B",
          "format": "table"
        }
      ]
    },
    {
      "title": "ExternalSecret sync lag (s since last success)",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 24, "w": 12, "h": 6},
      "id": 9,
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "time() - external_secret_sync_seconds_last_success",
          "legendFormat": "{{namespace}}/{{name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "green"},
              {"value": 300, "color": "yellow"},
              {"value": 600, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "title": "VPN tunnel state (1=UP, 0=DOWN)",
      "type": "stat",
      "gridPos": {"x": 12, "y": 24, "w": 12, "h": 6},
      "id": 10,
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "aws_ec2_tunnel_state",
          "legendFormat": "tunnel {{tunnel_ip_address}}",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {"0": {"text": "DOWN"}, "1": {"text": "UP"}}}
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "red"},
              {"value": 1, "color": "green"}
            ]
          }
        }
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["infrastructure", "aurora", "msk", "eks", "apex-ews"],
  "templating": {
    "list": [
      {"name": "DS_PROMETHEUS", "type": "datasource", "query": "prometheus", "label": "Prometheus"}
    ]
  },
  "time": {"from": "now-3h", "to": "now"},
  "title": "APEX EWS — Aurora + MSK + EKS infrastructure",
  "uid": "apex-ews-infra",
  "version": 1
}
