{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex-ews/schemas/apex.regulatory.events.v2.json",
  "title": "apex.regulatory.events",
  "version": "2.0.0",
  "compatibility": "BACKWARD",
  "description": "Canonical alert envelope emitted by agent-alert. v2 keeps every required v1 field — alert_id, raised_at, customer_id, severity, rule_firings[], scoring{} — and adds the merged-alert convenience fields agent-alert needs (rule_id, indicators_fired, pd, risk_level, top_reasons, reason_summary, ts). v1 consumers continue to work because every v1-required field is still required here.",
  "type": "object",
  "required": [
    "alert_id",
    "raised_at",
    "customer_id",
    "severity",
    "rule_firings",
    "scoring"
  ],
  "properties": {
    "alert_id": { "type": "string", "format": "uuid" },
    "raised_at": { "type": "string", "format": "date-time" },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "Alias for raised_at — kept for agent-alert internal envelope; consumers should prefer raised_at."
    },
    "customer_id": { "type": "string" },
    "loan_id": { "type": ["string", "null"] },
    "severity": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
    },
    "rule_id": {
      "type": "string",
      "description": "Convenience: the single rule that drove this alert. Matches rule_firings[0].rule_id when there's exactly one firing."
    },
    "indicators_fired": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Deduplicated indicator catalog ids (e.g. FIN-001) that contributed."
    },
    "pd": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "risk_level": {
      "type": ["string", "null"],
      "enum": ["Low", "Medium", "High", null],
      "description": "Score-band (from ai-copilot-svc /score). Mirrors scoring.risk_band in proper case."
    },
    "top_reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["feature", "shap_value"],
        "properties": {
          "feature": { "type": "string" },
          "value": {},
          "shap_value": { "type": "number" },
          "direction": { "type": "string", "enum": ["positive", "negative"] }
        },
        "additionalProperties": true
      }
    },
    "reason_summary": {
      "type": "string",
      "description": "Single-sentence human-readable description (used for SMS/email subject)."
    },
    "rule_firings": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["rule_id", "rule_version", "matched_at"],
        "properties": {
          "rule_id": { "type": "string" },
          "rule_version": { "type": ["string", "number"] },
          "matched_at": { "type": "string", "format": "date-time" },
          "indicator_value_ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "scoring": {
      "type": "object",
      "properties": {
        "pd": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "risk_band": {
          "type": ["string", "null"],
          "enum": ["LOW", "MEDIUM", "HIGH", null]
        },
        "shap_top": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["feature", "value"],
            "properties": {
              "feature": { "type": "string" },
              "value": { "type": "number" }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "trace_id": { "type": "string" }
  },
  "additionalProperties": false
}
