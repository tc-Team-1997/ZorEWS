# Build outputs
dist/
build/
target/

# Node
node_modules/
.npm/
npm-debug.log*

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# dbt
data/dbt/dbt_packages/
data/dbt/logs/
data/dbt/target/

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan

# Local services / Make orchestration
.pids/
.logs/
.outbox/
.store/
.queue/

# Vite / web
web/dist/
web/.vite/
*.local
.env
.env.local
.env.*.local

# SPA-generated report exports (scenario sim, monthly snapshots, etc.)
web/snapshot-*.pdf
web/snapshot-*.xlsx
web/snapshot-*.csv

# Stray top-level package-lock.json — there's no package.json at repo root,
# this gets created if `npm install` is run from the wrong directory.
/package-lock.json

# IDE / OS
.DS_Store
.idea/
.vscode/
*.swp

# ML artefacts you don't want to commit accidentally (keep checked-in copies under ml/models/)
*.joblib
!ml/models/**/*.joblib

# Claude Code — personal local settings (permission allowlists, etc.)
.claude/settings.local.json
